[0.188001, "o", "\u001b[2J\u001b[H$ bash run.sh showcase --presentation\r\nLLM Gateway / Go 大模型网关与用量管理\r\n\r\n应用  →  网关  →  本机 Qwen3-VL-8B\r\n           ├─ MySQL / MariaDB：账户、额度与请求账本\r\n           └─ Redis：API Key 请求频率限制\r\n\r\n本次运行真实调用 API，使用独立临时账户。\r\n五步演示：普通响应 / SSE / 幂等 / 额度 / Key 撤销\r\n\r\n"]
[10.227044, "o", "\u001b[2J\u001b[H$ bash run.sh showcase --presentation\r\n1/5 普通响应：调用本机模型并记录用量\r\nPOST /v1/chat/completions   stream=false\r\n问题：12 个苹果 + 买 8 个 - 送出 5 个，还剩几个？\r\n模型回答：\r\n"]
[10.602772, "o", "15\r\n"]
