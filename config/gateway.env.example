# Independent deployment example. Save filled values outside the repository.
# Database and Redis must be prepared before launching the Go binary.
LLMGW_ADDRESS=127.0.0.1:29480
LLMGW_DATA_ROOT=/data/zjr/llm_gateway_demo
LLMGW_DSN='gateway:REPLACE_DATABASE_PASSWORD@tcp(127.0.0.1:3306)/llm_gateway?parseTime=true&loc=UTC&timeout=3s&readTimeout=5s&writeTimeout=5s'
LLMGW_REDIS_ADDRESS=127.0.0.1:6379
LLMGW_REDIS_PASSWORD=''
LLMGW_ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARACTERS
LLMGW_MASTER_KEY=REPLACE_WITH_BASE64URL_32_RANDOM_BYTES_WITHOUT_PADDING
LLMGW_MAX_INFLIGHT=32
LLMGW_DB_CONNECTIONS=32
LLMGW_METADATA_DB_CONNECTIONS=2
LLMGW_REQUEST_TIMEOUT_SECONDS=120
LLMGW_DATABASE_READ_TIMEOUT_MS=1000
LLMGW_ADMISSION_TIMEOUT_MS=5000
LLMGW_RATE_LIMIT_TIMEOUT_MS=3000
LLMGW_STREAM_IDLE_SECONDS=20
LLMGW_LEASE_SECONDS=45
LLMGW_HEARTBEAT_SECONDS=5
LLMGW_ADMISSION_MODE=combined
LLMGW_REQUEST_ID_VERSION=7
LLMGW_MODEL_BASE_URL=http://127.0.0.1:28282/v1
LLMGW_MODEL_NAME=office-qwen3-vl-8b
LLMGW_MODEL_API_KEY=local-reuse
